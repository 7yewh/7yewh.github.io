---
import type { CollectionEntry } from 'astro:content';
import { localePath, splitEntryId, useTranslations } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
  large?: boolean;
}

const { entry, large = false } = Astro.props;
const { lang, slug } = splitEntryId(entry.id);
const t = useTranslations(lang);
const d = entry.data;
---

<a class:list={['card', 'project', { large }]} href={localePath(lang, `/projects/${slug}/`)}>
  <div class="media">
    {d.cover ? <img src={d.cover} alt={d.title} loading="lazy" /> : <div class="placeholder" aria-hidden="true"><span>{String(d.order).padStart(2, '0')}</span></div>}
  </div>
  <div class="body">
    {d.tags.length > 0 && <div class="tags">{d.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div>}
    <h3>{d.title}{d.draft && <span class="draft">{t('draft')}</span>}</h3>
    <p>{d.summary}</p>
    <span class="more">{t('readMore')} ›</span>
  </div>
</a>

<style>
  .media {
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover .media img {
    transform: scale(1.03);
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 80% at 80% 0%, rgba(255, 255, 255, 0.07), transparent 60%),
      linear-gradient(160deg, #1c1c1e, #0a0a0a);
    color: rgba(255, 255, 255, 0.1);
    font-size: 88px;
    font-weight: 600;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  h3 {
    font-size: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .large h3 {
    font-size: 26px;
  }
  .draft {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 980px;
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-2);
  }
  p {
    margin: 0;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.5;
    flex: 1;
  }
  .more {
    color: var(--text-2);
    font-size: 15px;
    font-weight: 500;
  }
  .card:hover .more {
    color: var(--text);
  }
  /* 首页首张精选卡：横向排版，图左文右 */
  .large {
    flex-direction: row;
  }
  .large .media {
    flex: 0 0 52%;
    aspect-ratio: auto;
    min-height: 340px;
  }
  .large .body {
    padding: 40px 44px;
    justify-content: center;
  }
  .large p {
    font-size: 17px;
    flex: 0;
  }
  @media (max-width: 734px) {
    .large {
      flex-direction: column;
    }
    .large .media {
      flex: none;
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
    .large .body {
      padding: 22px 24px 26px;
    }
  }
</style>
