---
import { getLangFromUrl, useTranslations, localePath, switchLangPath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang: Lang = lang === 'zh' ? 'en' : 'zh';

const items = [
  { href: localePath(lang, '/'), label: t('nav.home'), exact: true },
  { href: localePath(lang, '/projects/'), label: t('nav.projects') },
  { href: localePath(lang, '/blog/'), label: t('nav.blog') },
  { href: localePath(lang, '/about/'), label: t('nav.about') },
];

const path = Astro.url.pathname;
const isActive = (href: string, exact?: boolean) =>
  exact ? path === href || path === href.replace(/\/$/, '') : path.startsWith(href.replace(/\/$/, ''));
---

<header class="nav">
  <nav class="container nav-inner" aria-label="Main">
    <a class="brand" href={localePath(lang, '/')}>7yewh</a>
    <ul class="links">
      {items.map((it) => (
        <li>
          <a href={it.href} class:list={{ active: isActive(it.href, it.exact) }}>{it.label}</a>
        </li>
      ))}
    </ul>
    <div class="right">
      <a class="gh" href="https://github.com/7yewh" target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
      <a class="lang" href={switchLangPath(Astro.url, altLang)} hreflang={altLang}>{languages[altLang]}</a>
    </div>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    z-index: 100;
    background: rgba(0, 0, 0, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .brand {
    font-weight: 600;
    font-size: 19px;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0 auto 0 0;
    padding: 0;
  }
  .links a {
    font-size: 13px;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .links a:hover,
  .links a.active {
    color: var(--text);
    text-decoration: none;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .gh {
    color: var(--text-2);
    display: inline-flex;
  }
  .gh:hover {
    color: var(--text);
  }
  .lang {
    font-size: 13px;
    color: var(--text-2);
    padding: 4px 10px;
    border-radius: 980px;
    border: 1px solid var(--line);
  }
  .lang:hover {
    color: var(--text);
    text-decoration: none;
    border-color: var(--text-3);
  }
  @media (max-width: 734px) {
    .nav-inner {
      gap: 16px;
    }
    .links {
      gap: 16px;
    }
  }
</style>
