---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p>© {year} 7yewh. {t('footer.rights')}</p>
    <p>
      {t('footer.built')}
      <a href="https://github.com/7yewh" target="_blank" rel="noopener">GitHub</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 28px 0 40px;
    font-size: 12px;
    color: var(--text-3);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .footer p {
    margin: 0;
  }
  .footer a {
    color: var(--text-2);
    margin-left: 6px;
  }
</style>
