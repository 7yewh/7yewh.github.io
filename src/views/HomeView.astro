---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const posts = (await getCollection('blog', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const titleLines = t('hero.title').split('\n');
const subLines = t('hero.subtitle').split('\n');
---

<Base>
  <section class="hero" id="hero">
    <div class="bg" aria-hidden="true">
      <div class="grid-lines"></div>
      <div class="glow glow-a"></div>
      <div class="glow glow-b"></div>
      <div class="ring"></div>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow reveal" style="--d: 0ms">{t('hero.eyebrow')}</p>
      <h1>
        {titleLines.map((line, i) => (
          <span class="line reveal" style={`--d: ${160 + i * 140}ms`}><span class="shine">{line}</span></span>
        ))}
      </h1>
      <p class="sub">
        {subLines.map((line, i) => (
          <span class="reveal" style={`--d: ${520 + i * 120}ms`}>{line}</span>
        ))}
      </p>
      <div class="actions reveal" style="--d: 820ms">
        <a class="btn btn-primary" href={localePath(lang, '/projects/')}>{t('hero.cta')}</a>
        <a class="btn btn-ghost" href="https://github.com/7yewh" target="_blank" rel="noopener">{t('hero.github')}</a>
      </div>
    </div>
    <div class="scroll-hint reveal" style="--d: 1200ms" aria-hidden="true"><span></span></div>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head observe">
          <h2>{t('home.featured')}</h2>
          <p>{t('home.featured.sub')}</p>
          <a class="more" href={localePath(lang, '/projects/')}>{t('home.all')}</a>
        </div>
        <div class="grid featured">
          {featured.map((p, i) => <div class="observe" style={`--d: ${i * 90}ms`}><ProjectCard entry={p} large={i === 0} /></div>)}
        </div>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head observe">
          <h2>{t('home.recent')}</h2>
          <p>{t('home.recent.sub')}</p>
          <a class="more" href={localePath(lang, '/blog/')}>{t('home.allPosts')}</a>
        </div>
        <div class="posts">
          {posts.map((p, i) => <div class="observe" style={`--d: ${i * 80}ms`}><PostItem entry={p} /></div>)}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // 滚动进入视口时逐个浮现
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
  );
  document.querySelectorAll('.observe').forEach((el) => io.observe(el));

  // 首屏鼠标视差：光晕与标题轻微跟随
  const hero = document.getElementById('hero');
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && fine && !reduce) {
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const tick = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      hero.style.setProperty('--mx', cx.toFixed(3));
      hero.style.setProperty('--my', cy.toFixed(3));
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(tick);
      else raf = 0;
    };
    hero.addEventListener('mousemove', (ev) => {
      const r = hero.getBoundingClientRect();
      tx = (ev.clientX - r.left) / r.width - 0.5;
      ty = (ev.clientY - r.top) / r.height - 0.5;
      if (!raf) raf = requestAnimationFrame(tick);
    });
    hero.addEventListener('mouseleave', () => {
      tx = 0; ty = 0;
      if (!raf) raf = requestAnimationFrame(tick);
    });
  }
</script>

<style>
  .hero {
    --mx: 0;
    --my: 0;
    position: relative;
    min-height: calc(100vh - var(--nav-h));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 40px;
    padding-bottom: 80px;
    transform: translate3d(calc(var(--mx) * -10px), calc(var(--my) * -8px), 0);
    transition: transform 0.1s linear;
  }

  /* ---------- 背景层 ---------- */
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .grid-lines {
    position: absolute;
    inset: -1px;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 20%, transparent 75%);
    animation: grid-drift 24s linear infinite;
  }
  @keyframes grid-drift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 0 72px, 72px 0; }
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
  }
  .glow-a {
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    left: 50%;
    top: 20%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 65%);
    transform: translate3d(calc(-50% + var(--mx) * 40px), calc(-50% + var(--my) * 30px), 0);
    animation: breathe 9s ease-in-out infinite;
  }
  .glow-b {
    width: 40vw;
    height: 40vw;
    max-width: 520px;
    max-height: 520px;
    left: 62%;
    top: 62%;
    background: radial-gradient(circle, rgba(200, 200, 210, 0.16), rgba(255, 255, 255, 0) 65%);
    transform: translate3d(calc(-50% + var(--mx) * -60px), calc(-50% + var(--my) * -40px), 0);
    animation: breathe 12s ease-in-out infinite reverse;
  }
  @keyframes breathe {
    0%, 100% { opacity: 0.45; scale: 1; }
    50% { opacity: 0.7; scale: 1.08; }
  }
  .ring {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(92vw, 1100px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.07);
    transform: translate(-50%, -50%) rotate(0deg);
    mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 70%, transparent 100%);
  }
  .ring::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid transparent;
    border-top-color: rgba(255, 255, 255, 0.45);
    animation: spin 14s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ---------- 文字 ---------- */
  .hero h1 {
    margin: 18px auto 0;
    font-size: clamp(44px, 7.2vw, 92px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.06;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .line {
    display: block;
  }
  .shine {
    display: inline-block;
    background: linear-gradient(
      100deg,
      #8e8e93 0%,
      #ffffff 30%,
      #ffffff 50%,
      #8e8e93 70%,
      #ffffff 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 7s ease-in-out infinite;
  }
  .line:nth-child(2) .shine {
    animation-delay: 0.6s;
  }
  @keyframes sheen {
    0%, 20% { background-position: 110% 0; }
    60%, 100% { background-position: -110% 0; }
  }
  .sub {
    margin: 30px auto 0;
    max-width: 800px;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.5;
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sub span {
    display: block;
  }
  .actions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn-primary {
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.35);
    animation: pulse 3.2s ease-out 1.6s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.35); }
    70%, 100% { box-shadow: 0 0 0 14px rgba(255, 255, 255, 0); }
  }

  /* 向下滚动提示 */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 22px;
    height: 36px;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    transform: translateX(-50%);
    z-index: 2;
  }
  .scroll-hint span {
    position: absolute;
    left: 50%;
    top: 6px;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.7);
    animation: wheel 1.8s ease-in-out infinite;
  }
  @keyframes wheel {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  /* ---------- 入场动画 ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    filter: blur(6px);
    animation: reveal 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .observe {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }
  .observe.in {
    opacity: 1;
    transform: none;
  }

  .featured {
    grid-template-columns: repeat(2, 1fr);
  }
  .featured > .observe:first-child {
    grid-column: 1 / -1;
  }
  .featured .observe {
    display: flex;
  }
  .featured .observe > :global(.card) {
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .observe {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
      transition: none;
    }
    .grid-lines, .glow, .ring::before, .shine, .btn-primary, .scroll-hint span {
      animation: none;
    }
    .shine {
      background-position: 0 0;
    }
  }
  @media (max-width: 734px) {
    .hero {
      min-height: auto;
      padding: 88px 0 72px;
    }
    .hero-inner {
      padding-bottom: 0;
    }
    .scroll-hint {
      display: none;
    }
    .featured {
      grid-template-columns: 1fr;
    }
    .grid-lines {
      background-size: 48px 48px;
    }
  }
</style>
